# Environment Variables for SmartDocs AI

# Google AI Studio / Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional fallback) OpenAI API Key
OPENAI_API_KEY=

# PostgreSQL + pgvector Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartdocs_db

# Optional: Full Database URL override (e.g. Supabase, Neon, or Docker)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smartdocs_db

# Model Parameters (Google AI Studio Gemini Defaults)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
LLM_MODEL=gemini-3.8-flash

# RAG Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
RETRIEVAL_STRATEGY=hybrid
SIMILARITY_THRESHOLD=0.40
MMR_LAMBDA=0.70
