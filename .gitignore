# ============================================
# SmartDocs AI - Comprehensive .gitignore
# ============================================

# Environment Variables & Secrets (CRITICAL)
.env
*.env
!.env.example
.env.*
!.env.example.*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.pyre/

# Databases & Local State
*.db
*.sqlite
*.sqlite3
backend/smartdocs.db
backend/smartdocs.db-journal

# Uploads & User Files
backend/app/uploads/*
!backend/app/uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Node.js & Frontend
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project

# Logs
logs/
*.log
